generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  OWNER
  MEMBER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  phone         String?   @unique
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  emailVerified DateTime?
  phoneVerified DateTime?
  verificationCode String?
  stripeId      String?   @unique
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  name        String
  apiKey      String    @unique @default(cuid())
  userId      String    
  user        User      @relation(fields: [userId], references: [id])
  
  // Settings
  whatsappEnabled    Boolean @default(false)
  whatsappToken      String?
  whatsappPhoneId    String?
  whatsappVerifyToken String?
  whatsappAppSecret  String?
  
  wooCommerceEnabled Boolean @default(false)
  wooCommerceStoreUrl String?
  wooCommerceKey     String?
  wooCommerceSecret  String?
  
  courierEnabled     Boolean @default(false)
  courierApiKey      String?

  usage       Usage[]
  knowledge   Knowledge[]
  conversations Conversation[]
  customers     Customer[]
  checkoutSessions CheckoutSession[]
  carts         Cart[]
  
  // Safety Policies
  maxDiscount        Float   @default(0.20)
  maxQuantity        Int     @default(10)
  requireApproval    Boolean @default(false)
  confirmationRequired String[] @default(["checkout_start", "order_create", "apply_discount"])
  restrictedTools     String[] @default(["delete_customer", "override_price"])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  phone        String   
  name         String?
  email        String?
  address      String?
  city         String?
  lastOrderId  String?
  preferences  Json?    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  carts        Cart[]

  @@unique([projectId, phone])
}

model Cart {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id])
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  items      CartItem[]
  status     String     @default("active") // active, abandoned, converted
  subtotal   Float      @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId Int
  name      String
  price     Float
  quantity  Int
  image     String?
  createdAt DateTime @default(now())
}

model CheckoutSession {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  customerId   String
  cartId       String
  stage        String   @default("CART_REVIEW") // CART_REVIEW, CUSTOMER_INFO, SHIPPING, PAYMENT, CONFIRMED
  customerData Json?    // Stores collected name, address, etc.
  shippingInfo Json?
  paymentId    String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Usage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  tokens    Int
  timestamp DateTime @default(now())
}

model Knowledge {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  content   String
  embedding Float[]
  createdAt DateTime @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  sessionId String?
  userId    String
  message   String
  response  String
  createdAt DateTime @default(now())

  @@index([projectId, sessionId, createdAt])
}

model EmbeddingCache {
  id        String   @id @default(cuid())
  text      String   @unique
  embedding Float[]
  createdAt DateTime @default(now())
}

model SystemEvent {
  id         String   @id @default(cuid())
  projectId  String
  sessionId  String?
  sequenceId Int      @default(0)
  type       String
  payload    Json
  timestamp  DateTime @default(now())

  @@index([projectId, sessionId, sequenceId])
}
