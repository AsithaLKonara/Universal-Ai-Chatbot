# Database (Prisma / PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/omnichat"
PRISMA_ACCELERATE_URL=""

# Authentication (Custom JWT)
JWT_SECRET="your_super_secret_jwt_key_here"

# Supabase (Vector DB & Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Redis (BullMQ queues)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Upstash Redis (Edge Cache & Analytics)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
UPSTASH_REDIS_REST_URL_EU="" # Optional Multi-region failover
UPSTASH_REDIS_REST_URL_US="" # Optional Multi-region failover

# Groq (Llama 3 inference)
GROQ_API_KEY="gsk_your_api_key_here"

# Stripe (Payments)
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# WooCommerce (Commerce Engine)
WOOCOMMERCE_STORE_URL="https://your-store.com"
WC_WEBHOOK_SECRET="your_wc_webhook_secret"

# Observability & Alerts
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook"
CHAOS_MODE="false"
